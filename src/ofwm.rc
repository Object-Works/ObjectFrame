#include <winres.h>

#include "resource.h"
#include "version.h"

// First icon in the file is what Explorer shows for the exe.
IDI_OFWM ICON "ofwm.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OFWM_VERSION_MAJOR, OFWM_VERSION_MINOR, OFWM_VERSION_PATCH, 0
 PRODUCTVERSION OFWM_VERSION_MAJOR, OFWM_VERSION_MINOR, OFWM_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104B0"
        BEGIN
            VALUE "CompanyName", "Object Works"
            VALUE "FileDescription", "ObjectFrame tiling window manager"
            VALUE "FileVersion", OFWM_VERSION_STRING
            VALUE "InternalName", "ofwm"
            VALUE "OriginalFilename", "ofwm.exe"
            VALUE "ProductName", "ObjectFrame"
            VALUE "ProductVersion", OFWM_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
